# Copy this file to .env in your Odysseus checkout (or add this line to the
# .env you already have there) and fill in your own token. Never commit the
# real .env file.

# Notion internal integration token.
# 1. Create an integration: https://www.notion.so/profile/integrations
#    - Type: Internal
#    - Capabilities: "Read content" only (leave update/insert unchecked)
# 2. Copy its "Internal Integration Secret" (starts with secret_ or ntn_) here.
# 3. In Notion, share the pages/databases you want searchable with that
#    integration: open the page -> "..." menu -> Connections -> add it.
#    Sub-pages inherit the connection automatically.
NOTION_TOKEN=
